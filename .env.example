# Tokens da Meta. Nunca compartilhe este arquivo.
# Um por cliente, gerado na BM do cliente. O nome segue a pasta do cliente, em maiúsculas.
# META_TOKEN_NOMEDOCLIENTE=

# Só se o teu aplicativo tem acesso avançado aprovado e um token atende todos os clientes:
# META_TOKEN=

# Opcional: fixa a versão da API da Meta (ex: v25.0). Vazio usa a versão padrão do kit.
META_API_VERSION=
